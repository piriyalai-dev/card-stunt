# Pixel Stand — ตัวอย่างตัวแปรสภาพแวดล้อม
# คัดลอกเป็น .env แล้วแก้ค่าจริง:  cp .env.example .env

# --- โดเมน (Host() ของ traefik — ใช้เมื่อ deploy ลง Swarm · Phase 5) ---
API_DOMAIN=api.pixel.pirivoice.com
WEB_DOMAIN=pixel.pirivoice.com

# --- Postgres (docker-compose.infra.yml อ่าน) ---
POSTGRES_USER=pixelstand
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pixelstand_db

# --- Backend (บังคับ — ไม่มี default จะ boot ไม่ขึ้น) ---
DATABASE_URL=postgresql://pixelstand:CHANGE_ME@localhost:5432/pixelstand_db
API_KEY=CHANGE_ME
SECRET_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME

# --- Seed users (id ผู้ใช้ที่เป็น God Mode — เว้นว่าง = ไม่ใช้) ---
SUPER_ADMIN_ID=

# --- Frontend (build arg — กำหนดตอน build image) ---
VITE_API_BASE_URL=http://localhost:8000
