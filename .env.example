# Pixel Stand — ตัวอย่างตัวแปรสภาพแวดล้อม
# คัดลอกเป็น .env แล้วแก้ค่าจริง:  cp .env.example .env

# --- โดเมน (Host() ของ traefik — ใช้เมื่อ deploy ลง Swarm · Phase 5) ---
# เครื่องนี้: ใช้ pixel.singto1597.xyz (route ผ่าน Cloudflare tunnel ทีหลัง)
# เซิร์ฟเวอร์ pirivoice: เปลี่ยนเป็น pixel.pirivoice.com ตอน deploy จริง
API_DOMAIN=api.pixel.singto1597.xyz
WEB_DOMAIN=pixel.singto1597.xyz

# --- Postgres (docker-compose.infra.yml อ่าน) ---
POSTGRES_USER=pixelstand
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pixelstand_db

# --- Backend (บังคับ — ไม่มี default จะ boot ไม่ขึ้น) ---
DATABASE_URL=postgresql://pixelstand:CHANGE_ME@localhost:5432/pixelstand_db
API_KEY=CHANGE_ME
SECRET_KEY=CHANGE_ME
JWT_SECRET=CHANGE_ME

# --- CORS (origin ของ frontend ที่เรียก API — คั่นด้วย comma) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://pixel.singto1597.xyz,http://pixel.singto1597.xyz

# --- Seed users (id ผู้ใช้ที่เป็น God Mode — 0 = ไม่ใช้) ---
SUPER_ADMIN_ID=0

# --- Redis (public cache + ETag — ว่าง = ปิด cache อ่าน DB ตรง ๆ) ---
# Docker Compose (app) override ไปที่ pixelstand_infra_redis:6379/1 — ค่านี้ใช้ตอนรันบน host
REDIS_URL=redis://localhost:6379/1

# --- Live sync (SSE) — channel ต้องตรงกับ migration 004 (อย่าเปลี่ยนถ้าไม่จำเป็น) ---
NOTIFY_CHANNEL=pixelstand_live
STREAM_HEARTBEAT_SECONDS=20
STREAM_MAX_SUBSCRIBERS=2000

# --- Media (reference image + thumbnail — signed URL มา Phase 5) ---
MEDIA_STORAGE_DIR=/data/media
MEDIA_MAX_UPLOAD_MB=10

# --- Limits (design §11) ---
MAX_TOTAL_CELLS=200000
REVISION_RETENTION=20

# --- Frontend (build arg — กำหนดตอน build image) ---
# dev บน host: http://localhost:8000 · deploy เครื่องนี้: https://api.pixel.singto1597.xyz
VITE_API_BASE_URL=http://localhost:8000
